---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import { getTagListings, tagUrl } from '../../lib/posts';

const tags = await getTagListings();
---

<BaseLayout
	title={`Tags - ${SITE_TITLE}`}
	description="Every topic written about on this site, with the posts under each."
	searchable={false}
>
	<h1>Tags</h1>
	<p>Every topic written about here, in alphabetical order.</p>

	{
		tags.length === 0 ? (
			<p>Nothing has been tagged yet.</p>
		) : (
			<ul class="tag-list">
				{tags.map(({ tag, posts }) => (
					<li>
						<a href={tagUrl(tag)}>{tag}</a>{' '}
						<span class="count">
							({posts.length}
							{posts.length === 1 ? ' post' : ' posts'})
						</span>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>

<style>
	.tag-list {
		margin: 0;
		padding-left: 1.5rem;
	}
	.tag-list > li {
		margin-bottom: 0.4rem;
	}
	.count {
		color: rgb(var(--gray));
	}
</style>
