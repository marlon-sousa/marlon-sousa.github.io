---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE } from '../consts';
import { getLatestReleases } from '../data/releases';

// Fetched from the GitHub API at build time. See src/data/releases.ts.
const releases = await getLatestReleases();
---

<BaseLayout
	title={`Releases - ${SITE_TITLE}`}
	description="Latest software and add-on releases by Marlon Sousa"
	width="wide"
>
	<h1>Latest Releases</h1>
	<p>
		The most recent published release of each project. This page is generated from GitHub when the
		site is built, so it never falls behind.
	</p>

	{
		releases.length === 0 ? (
			<p>No releases are available right now. Please check the project repositories directly.</p>
		) : (
			releases.map((release) => (
				<article class="release-card">
					<h2>
						{release.project.name} {release.version}
					</h2>
					{release.publishedAt && (
						<p class="date">
							Released <FormattedDate date={release.publishedAt} />
						</p>
					)}
					{release.notes ? (
						<p class="notes">{release.notes}</p>
					) : (
						<p>{release.project.description}</p>
					)}
					<p>
						<a href={release.url} target="_blank" rel="noopener noreferrer">
							Download {release.project.name} {release.version}
						</a>
					</p>
				</article>
			))
		)
	}
</BaseLayout>

<style>
	.release-card {
		background-color: rgba(var(--gray-light), 30%);
		border-left: 4px solid var(--accent);
		padding: 1.5em;
		margin-bottom: 1.5em;
	}
	.release-card h2 {
		margin-top: 0;
		font-size: 1.563em;
	}
	.date {
		color: rgb(var(--gray));
		margin-bottom: 0.5em;
	}
	/* Release notes arrive as Markdown; preserve their line breaks without
	   rendering untrusted HTML. */
	.notes {
		white-space: pre-wrap;
	}
</style>
