---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { seriesUrl } from '../../data/series';
import { getSeriesListings } from '../../lib/posts';

const listings = await getSeriesListings();
---

<BaseLayout
	title={`Series - ${SITE_TITLE}`}
	description="Multi-part article series, each written to be read in order."
	width="wide"
	searchable={false}
>
	<h1>Series</h1>
	<p>
		Some subjects do not fit in one post. These are written to be read in order, though each part
		stands on its own.
	</p>

	{
		listings.length === 0 ? (
			<p>No series has been published yet.</p>
		) : (
			<ul class="series-list">
				{listings.map(({ series, parts, updated }) => (
					<li>
						<article>
							<h2 class="title">
								<a href={seriesUrl(series.slug)}>{series.title}</a>
							</h2>
							<p class="meta">
								{parts.length}
								{parts.length === 1 ? ' part' : ' parts'} published
								{series.parts.length > parts.length && (
									<> of {series.parts.length} planned</>
								)}
								{' — last updated '}
								<FormattedDate date={updated} />
							</p>
							<p>{series.description}</p>
						</article>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>

<style>
	.series-list {
		list-style-type: none;
		margin: 0;
		padding: 0;
	}
	.series-list > li {
		margin-bottom: 2.5rem;
	}
	.title {
		margin: 0;
		font-size: 1.953em;
	}
	.title a {
		text-decoration: none;
	}
	.title a:hover {
		text-decoration: underline;
	}
	.meta {
		margin: 0 0 0.5em 0;
		color: rgb(var(--gray));
	}
</style>
