---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import type { Series } from '../../data/series';
import { getSeriesListings, getSeriesOutline, postUrl, type SeriesEntry } from '../../lib/posts';

export async function getStaticPaths() {
	const listings = await getSeriesListings();
	return Promise.all(
		listings.map(async ({ series }) => ({
			params: { slug: series.slug },
			props: { series, outline: await getSeriesOutline(series.slug) },
		})),
	);
}

interface Props {
	series: Series;
	outline: SeriesEntry[];
}

const { series, outline } = Astro.props;
const published = outline.filter((entry) => entry.post).length;
---

<BaseLayout title={series.title} description={series.description} searchable={false}>
	<h1>{series.title}</h1>
	<p class="lede">{series.intro ?? series.description}</p>
	<p class="progress">
		{published} of {outline.length} parts published.
	</p>

	<h2>Parts</h2>
	<ol class="parts">
		{
			outline.map((entry) => (
				<li value={entry.number}>
					{entry.post ? (
						<>
							<h3>
								<a href={postUrl(entry.post)}>{entry.title}</a>
								{entry.post.data.draft && <span class="note"> (draft)</span>}
							</h3>
							<p class="date">
								<FormattedDate date={entry.post.data.pubDate} />
							</p>
							<p>{entry.post.data.description}</p>
						</>
					) : (
						<>
							{/* Not a link: a disabled link still lands in a screen reader's
							    link list and the tab order, promising a page that is not there. */}
							<h3 class="unwritten">{entry.title}</h3>
							<p class="note">Not published yet</p>
							{entry.summary && <p>{entry.summary}</p>}
						</>
					)}
				</li>
			))
		}
	</ol>
</BaseLayout>

<style>
	.lede {
		font-size: 1.1em;
	}
	.progress {
		color: rgb(var(--gray));
	}
	.parts {
		padding-left: 1.5rem;
	}
	.parts > li {
		margin-bottom: 2rem;
	}
	.parts h3 {
		margin: 0;
		font-size: 1.3em;
	}
	.parts h3 a {
		text-decoration: none;
	}
	.parts h3 a:hover {
		text-decoration: underline;
	}
	.unwritten {
		color: rgb(var(--gray));
	}
	.date {
		margin: 0 0 0.4em 0;
		color: rgb(var(--gray));
	}
	.note {
		margin: 0 0 0.4em 0;
		font-size: 0.9em;
		color: rgb(var(--gray));
	}
</style>
