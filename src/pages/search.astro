---
import BaseLayout from '../layouts/BaseLayout.astro';
import Search from 'astro-pagefind/components/Search.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout
	title={`Search - ${SITE_TITLE}`}
	description="Search all articles and pages on this site"
	width="wide"
>
	<h1>Search Content</h1>
	<p>Use the search box below to instantly search through all articles and pages.</p>

	<Search className="pagefind-ui" />
</BaseLayout>
