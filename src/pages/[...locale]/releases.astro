---
// The Releases page used to list each project's latest release. That now sits
// on each Projects card, and news of a release is on the News page, so this
// page only remains to send links and bookmarks made before the change on to
// Projects, at once. GitHub Pages has no server-side redirects, so it is a page
// that refreshes; it still says where it points, for a browser that does not.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import { localeRoutes } from '../../lib/posts';
import { localeUrl, type Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

export const getStaticPaths = localeRoutes;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const projects = localeUrl('/projects/', locale);
const [before = '', after = ''] = t('moved.releases').split('{link}');
---

<BaseLayout
	title={t('site.pageTitle', { page: t('projects.title'), site: SITE_TITLE })}
	description={t('projects.description')}
	searchable={false}
	movedTo={projects}
>
	<h1>{t('projects.title')}</h1>
	<p>{before}<a href={projects}>{t('moved.releasesLink')}</a>{after}</p>
</BaseLayout>
