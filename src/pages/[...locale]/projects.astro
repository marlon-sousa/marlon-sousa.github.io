---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import { projects, repoUrl } from '../../data/projects';
import { localeRoutes } from '../../lib/posts';
import { pick } from '../../i18n/localized';
import type { Locale } from '../../i18n/config';
import { useTranslations } from '../../i18n/ui';

export const getStaticPaths = localeRoutes;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
---

<BaseLayout
	title={t('site.pageTitle', { page: t('projects.title'), site: SITE_TITLE })}
	description={t('projects.description')}
	width="wide"
>
	<h1>{t('projects.title')}</h1>
	<p>{t('projects.intro')}</p>

	{
		projects.map((project) => (
			<article class="project-card">
				<h2>{project.name}</h2>
				<p>{pick(project.description, locale)}</p>
				<p>
					<a href={repoUrl(project)} target="_blank" rel="noopener noreferrer">
						{t('projects.view', { repo: project.repo })}
					</a>
				</p>
			</article>
		))
	}
</BaseLayout>

<style>
	.project-card {
		background-color: rgba(var(--gray-light), 30%);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		padding: 1.5em;
		margin-bottom: 1.5em;
	}
	.project-card h2 {
		margin-top: 0;
		font-size: 1.563em;
	}
</style>
