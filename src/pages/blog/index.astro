---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { seriesUrl } from '../../data/series';
import { getBlogFeed, postUrl } from '../../lib/posts';

// Every article is its own entry. A part of a series says so above its title,
// and links out to the series page for the rest.
const feed = await getBlogFeed();
---

<BaseLayout
	title={`Blog - ${SITE_TITLE}`}
	description="Articles on accessibility, screen readers, and software development"
	width="wide"
	searchable={false}
>
	<h1>Blog</h1>
	<p>Everything published here, newest first. You can also <a href="/tags">browse by tag</a>.</p>

	{
		feed.length === 0 ? (
			<p>No posts have been published yet.</p>
		) : (
			<ul class="post-list">
				{feed.map(({ post, nav }) => (
					<li>
						<article>
							{nav && (
								<p class="kind">
									<a href={seriesUrl(nav.series.slug)}>{nav.series.title}</a> — part {nav.part} of{' '}
									{nav.total}
								</p>
							)}
							<h2 class="title">
								<a href={postUrl(post)}>{post.data.title}</a>
								{post.data.draft && <span class="draft"> (draft)</span>}
							</h2>
							<p class="date">
								<FormattedDate date={post.data.pubDate} />
							</p>
							{post.data.heroImage && (
								<a href={postUrl(post)} tabindex="-1" aria-hidden="true">
									<Image width={720} height={360} src={post.data.heroImage} alt="" />
								</a>
							)}
							<p>{post.data.description}</p>
						</article>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>

<style>
	.post-list {
		list-style-type: none;
		margin: 0;
		padding: 0;
	}
	.post-list > li {
		margin-bottom: 3rem;
	}
	.title {
		margin: 0;
		font-size: 1.953em;
	}
	.title a {
		text-decoration: none;
	}
	.title a:hover {
		text-decoration: underline;
	}
	.date {
		margin: 0 0 0.5em 0;
		color: rgb(var(--gray));
	}
	/* The series label above a part's title. Deliberately quieter than the
	   title, and not uppercased: it carries a proper noun and a part number,
	   both of which read worse in capitals. */
	.kind {
		margin: 0 0 0.15em 0;
		font-size: 0.9em;
		color: rgb(var(--gray));
	}
	.draft {
		font-size: 0.7em;
		font-weight: 400;
		color: rgb(var(--gray));
	}
	.post-list img {
		margin-bottom: 0.5rem;
		border-radius: 12px;
	}
</style>
