---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';
import { alternatesFor, getLocale, localeMeta, localeUrl, type Locale } from '../i18n/config';
import { ogPath } from '../lib/og';
import LanguagePreference from './LanguagePreference.astro';

interface Props {
	title: string;
	description: string;
	/** A post's hero image, when it has one. Preferred for social previews. */
	image?: ImageMetadata;
	/**
	 * Path to a generated Open Graph image, used when there is no hero image.
	 * Defaults to the site-wide card. See src/pages/og/[...slug].png.ts.
	 */
	ogImage?: string;
	/**
	 * Where this page can be read in each language, as locale → path.
	 *
	 * Left out by every page that is a straight translation of one route, since
	 * those alternates are just this path under each locale prefix. An article
	 * passes its own map: its Portuguese slug is not its English one, and the
	 * translation may not exist at all, in which case it is absent here and the
	 * page advertises no alternate rather than one that would 404.
	 */
	translations?: Partial<Record<Locale, string>>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image, translations } = Astro.props;

const locale = getLocale(Astro.url);
const meta = localeMeta[locale];

const { ogImage = ogPath('site', locale) } = Astro.props;

// A generated card carries the page's own title, so it beats no image at all —
// but a real hero image, when the author chose one, beats both.
const socialImage = image ? new URL(image.src, Astro.url) : new URL(ogImage, Astro.site);

// One entry per language this page exists in. A page with only one is not
// translated, and gets no alternates at all: a single hreflang pointing at
// itself tells a crawler nothing it did not already know.
const alternates = translations ?? alternatesFor(Astro.url.pathname);
const alternateEntries = Object.entries(alternates) as [Locale, string][];
const isTranslated = alternateEntries.length > 1;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="color-scheme" content="light dark" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL(localeUrl('/rss.xml', locale), Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Proof of ownership for Google Search Console. Not a secret: it only tells
     Google that whoever controls this site also controls that account, and it
     has to stay in place for the property to remain verified. -->
<meta name="google-site-verification" content="9lj6nRXPyK-Ln_xR_021ovRufNrqqlKcXbgW9xzLulw" />

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!--
  Which languages this page exists in.

  x-default names the version to serve a reader whose language we do not
  publish in, which is English — not because it is the original, but because
  it is the one more of them will be able to read.
-->
{
	isTranslated && (
		<>
			{alternateEntries.map(([code, path]) => (
				<link rel="alternate" hreflang={localeMeta[code].tag} href={new URL(path, Astro.site)} />
			))}
			{alternates.en && <link rel="alternate" hreflang="x-default" href={new URL(alternates.en, Astro.site)} />}
		</>
	)
}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={meta.ogLocale} />
{
	alternateEntries
		.filter(([code]) => code !== locale)
		.map(([code]) => <meta property="og:locale:alternate" content={localeMeta[code].ogLocale} />)
}
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={title} />

<LanguagePreference translations={alternates} />

<!--
  Visit counting, GoatCounter. No cookies, and nothing that identifies a reader
  is stored, so there is no consent banner to put in anybody's way.

  Only in a production build: `astro dev`, `astro preview` and the a11y sweep
  would otherwise report my own machine as an audience. count.js ignores
  localhost on its own, but a tag that is not there cannot be miscounted.
-->
{
	import.meta.env.PROD && (
		<script
			is:inline
			data-goatcounter="https://marlon-sousa.goatcounter.com/count"
			async
			src="https://gc.zgo.at/count.js"
		/>
	)
}
