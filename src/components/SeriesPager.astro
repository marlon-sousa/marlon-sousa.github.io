---
// Previous / next at the foot of a series article.
//
// A neighbouring part that is not written yet is still named, as plain text
// rather than a dead link: a disabled link still lands in a screen reader's list
// of links and in the tab order, promising somewhere to go that does not exist.
//
// A part that is written but not translated is a different case, and is a real
// link: it goes somewhere, and ArticleLink says which language it goes to.
import ArticleLink from './ArticleLink.astro';
import { seriesUrl } from '../data/series';
import { type SeriesNav, type SeriesEntry } from '../lib/posts';
import { getLocale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
	nav: SeriesNav;
}

const { nav } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const label = (direction: string, entry: SeriesEntry) =>
	t('pager.entry', { direction, number: entry.number, title: entry.title });

const previousLabel = nav.previous && label(t('pager.previous'), nav.previous);
const nextLabel = nav.next && label(t('pager.next'), nav.next);
---

<nav class="series-pager" aria-label={t('pager.label', { series: nav.series.title })}>
	<h2>{t('pager.heading')}</h2>
	<ul>
		{
			nav.previous &&
				(nav.previous.article ? (
					<li>
						<ArticleLink article={nav.previous.article} label={previousLabel} rel="prev" />
					</li>
				) : (
					<li class="unpublished">{t('pager.unpublished', { entry: previousLabel as string })}</li>
				))
		}
		{
			nav.next &&
				(nav.next.article ? (
					<li>
						<ArticleLink article={nav.next.article} label={nextLabel} rel="next" />
					</li>
				) : (
					<li class="unpublished">{t('pager.unpublished', { entry: nextLabel as string })}</li>
				))
		}
		<li>
			<a href={seriesUrl(nav.series.slug, locale)}>
				{t('pager.all', { total: nav.total, series: nav.series.title })}
			</a>
		</li>
	</ul>
</nav>

<style>
	.series-pager {
		margin-top: 3rem;
		padding-top: 1rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.series-pager h2 {
		font-size: 1.2em;
		margin: 0 0 0.5rem 0;
	}
	.series-pager ul {
		margin: 0;
		padding: 0;
		list-style-type: none;
	}
	.series-pager li {
		margin-bottom: 0.4rem;
	}
	.unpublished {
		color: rgb(var(--gray));
	}
</style>
