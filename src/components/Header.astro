---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLocale, languageName, localeMeta, localeUrl, stripLocale, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';
import { getArticle, postUrl } from '../lib/posts';

interface Props {
	/** Locale → path, for the languages this page exists in. */
	translations: Partial<Record<Locale, string>>;
}

const { translations } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);

// Every destination in the nav exists in every language, so each href is just
// the same route under this page's locale prefix. Following a nav link never
// changes the language you are reading in.
//
// The one exception is the manifesto. It is an article, not a route, so it is
// the one nav destination that may not exist in this language yet. It goes
// through the same rule as every other link to an article — the reader's
// language if it exists, English otherwise, said inside the link — rather than
// being hidden or pointing at a page that was not built.
const manifesto = await getArticle('manifesto', locale);
if (!manifesto) {
	throw new Error('The header links to the article "manifesto", which is not published.');
}

// An article lives under /blog/, so without this both Blog and Manifesto would
// claim the current page while reading the manifesto. Exactly one does.
const here = (path: string) => stripLocale(path.replace(import.meta.env.BASE_URL, '/'));
const onManifesto = here(Astro.url.pathname) === here(postUrl(manifesto.post));

interface NavLink {
	href: string;
	label: string;
	/** Left undefined to let HeaderLink decide by section. */
	active?: boolean;
	/** Set when the destination is an article in another language. */
	fallbackFrom?: Locale;
}

const links: NavLink[] = [
	{ href: localeUrl('/', locale), label: t('nav.home') },
	{ href: localeUrl('/blog/', locale), label: t('nav.blog'), active: onManifesto ? false : undefined },
	// The series index lists every series that has something published, so the
	// menu needs one link rather than a submenu. A submenu would put every
	// series in the tab order of every page on the site to save one keystroke.
	{ href: localeUrl('/series/', locale), label: t('nav.series') },
	{
		href: postUrl(manifesto.post),
		label: t('nav.manifesto'),
		active: onManifesto,
		fallbackFrom: manifesto.fallback ? manifesto.locale : undefined,
	},
	{ href: localeUrl('/projects/', locale), label: t('nav.projects') },
	{ href: localeUrl('/releases/', locale), label: t('nav.releases') },
	{ href: localeUrl('/search/', locale), label: t('nav.search') },
];
---

<header>
	<nav aria-label={t('nav.primary')}>
		<p class="site-title"><a href={localeUrl('/', locale)}>{SITE_TITLE}</a></p>
		<div class="internal-links">
			{links.map(({ href, label, active, fallbackFrom }) => (
				<HeaderLink
					href={href}
					active={active}
					hreflang={fallbackFrom ? localeMeta[fallbackFrom].tag : undefined}
				>
					{label}
					{fallbackFrom && (
						<>
							{' '}
							<span class="marker">
								{t('lang.fallback', { language: languageName(fallbackFrom, locale) })}
							</span>
						</>
					)}
				</HeaderLink>
			))}
		</div>
		<LanguageSwitcher translations={translations} />
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: rgb(var(--surface));
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	.site-title {
		margin: 0;
		font-size: 1em;
		font-weight: 700;
	}
	.site-title a {
		color: rgb(var(--black));
		text-decoration: none;
	}
	/*
	  A grid rather than a flex row, because the language switcher renders
	  nothing on a page with no translation. A flex row spreading its children
	  apart has one fewer child to spread there, and the menu jumped to the right
	  edge on exactly those pages. The grid areas are there whether or not
	  anything fills them, so the menu is where it is on every page.

	  Narrow: title and switcher share the first row, the menu has the second.
	  Wide: the menu sits between them, and the two 1fr columns are equal by
	  definition, so it is centred on the bar without anything being computed.
	  The breakpoint is the width at which the longest menu (Portuguese, with
	  the manifesto's language marker) fits between the title and a mirror of
	  it; scripts/layout.mjs fails if it stops fitting.
	*/
	nav {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-areas:
			'title switcher'
			'links links';
		align-items: center;
		column-gap: 1em;
	}
	/* The links carry their own 1em of padding and the title does not, so on its
	   own row the title needs the same, or it sits against the top edge. */
	.site-title {
		grid-area: title;
		padding-top: 1em;
	}
	.internal-links {
		grid-area: links;
	}
	nav > :global(.language-switcher) {
		grid-area: switcher;
		justify-self: end;
	}
	@media (min-width: 82em) {
		nav {
			grid-template-columns: 1fr auto 1fr;
			grid-template-areas: 'title links switcher';
		}
		.site-title {
			padding-top: 0;
		}
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	/* The same marker ArticleLink draws: part of the link, quieter than its label. */
	.marker {
		font-size: 0.75em;
		font-weight: 400;
		color: rgb(var(--gray));
		white-space: nowrap;
	}
</style>
