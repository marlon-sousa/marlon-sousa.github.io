---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLocale, localeUrl, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
	/** Locale → path, for the languages this page exists in. */
	translations: Partial<Record<Locale, string>>;
}

const { translations } = Astro.props;
const locale = getLocale(Astro.url);
const t = useTranslations(locale);

// Every destination in the nav exists in every language, so each href is just
// the same route under this page's locale prefix. Following a nav link never
// changes the language you are reading in.
const links = [
	{ href: localeUrl('/', locale), label: t('nav.home') },
	{ href: localeUrl('/blog/', locale), label: t('nav.blog') },
	{ href: localeUrl('/projects/', locale), label: t('nav.projects') },
	{ href: localeUrl('/releases/', locale), label: t('nav.releases') },
	{ href: localeUrl('/search/', locale), label: t('nav.search') },
];
---

<header>
	<nav aria-label={t('nav.primary')}>
		<p class="site-title"><a href={localeUrl('/', locale)}>{SITE_TITLE}</a></p>
		<div class="internal-links">
			{links.map(({ href, label }) => <HeaderLink href={href}>{label}</HeaderLink>)}
		</div>
		<LanguageSwitcher translations={translations} />
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: rgb(var(--surface));
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	.site-title {
		margin: 0;
		font-size: 1em;
		font-weight: 700;
	}
	.site-title a {
		color: rgb(var(--black));
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
</style>
