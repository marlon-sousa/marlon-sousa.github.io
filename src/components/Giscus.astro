---
import { getLocale, localeMeta } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

// Comments powered by Giscus (GitHub Discussions).
//
// The category is "Announcements" rather than a custom one because only
// maintainers can open a discussion there. Readers still comment normally —
// giscus creates the thread on their behalf through its GitHub App — but nobody
// can start comment threads out of band, so the discussion list stays a
// one-to-one mirror of the pages on this site.
//
// Both IDs come from the GitHub GraphQL API (`repository { id
// discussionCategories { nodes { id name } } }`), not from giscus.app's form.
// They are public identifiers, not secrets. If `repoId` or `categoryId` is ever
// blanked, the component renders nothing rather than loading a script that would
// fail — which is also what happens before the giscus App is installed on the
// repository, since without it giscus cannot create the discussion.
const GISCUS = {
	repo: 'marlon-sousa/marlon-sousa.github.io',
	repoId: 'R_kgDOPBVKsw',
	category: 'Announcements',
	categoryId: 'DIC_kwDOPBVKs84DC1B4',
};

//
// `data-mapping="pathname"` means the two language versions of an article carry
// two separate threads, because they are two separate paths. That is the right
// answer rather than a limitation: a reader who comments in Portuguese under the
// Portuguese article is talking to the people reading it.
const isConfigured = Boolean(GISCUS.repoId && GISCUS.categoryId);

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
---

{
	isConfigured && (
		<section class="giscus-wrapper" aria-label={t('post.comments')}>
			<h2>{t('post.comments')}</h2>
			<div class="giscus" />
			<script
				src="https://giscus.app/client.js"
				data-repo={GISCUS.repo}
				data-repo-id={GISCUS.repoId}
				data-category={GISCUS.category}
				data-category-id={GISCUS.categoryId}
				data-mapping="pathname"
				data-strict="0"
				data-reactions-enabled="1"
				data-emit-metadata="0"
				data-input-position="bottom"
				data-theme="preferred_color_scheme"
				data-lang={localeMeta[locale].giscus}
				crossorigin="anonymous"
				is:inline
				async
			/>
		</section>
	)
}

<style>
	.giscus-wrapper {
		margin-top: 3em;
		padding-top: 2em;
		border-top: 1px solid rgb(var(--gray-light));
	}
</style>
