---
import type { HTMLAttributes } from 'astro/types';
import { stripLocale } from '../i18n/config';

type Props = HTMLAttributes<'a'> & {
	/**
	 * Overrides the section rule below. The header uses it to keep two links from
	 * both claiming the current page when one destination lies inside another's
	 * section — the manifesto is an article, so it is under /blog/.
	 */
	active?: boolean;
};

const { href, class: className, active, ...props } = Astro.props;

/**
 * The top-level section a path belongs to, with the language taken off.
 *
 * Both sides are reduced to this before being compared, so /pt/blog/ marks the
 * same nav item as /blog/ — the reader is in the same section of the site,
 * reading it in a different language — and so an article deep under /blog/
 * still marks Blog as the current page.
 */
function section(path: string): string {
	const [first] = stripLocale(path.replace(import.meta.env.BASE_URL, '/')).split('/').filter(Boolean);
	return `/${first ?? ''}`;
}

const isActive = active ?? section(String(href ?? '/')) === section(Astro.url.pathname);

// The current page's link is bold, and bold text is wider. Without this the
// menu shifted by a few pixels every time the reader changed section. The label
// is set twice in the same grid cell: the visible one, and a bold copy that is
// never seen and only holds the link at its bold width on every page.
//
// The copy is `visibility: hidden`, which also takes it out of the
// accessibility tree and out of find-in-page; aria-hidden says so explicitly,
// and Pagefind is told to skip it so search does not index every label twice.
const label = await Astro.slots.render('default');
---

<a
	href={href}
	class:list={[className, { active: isActive }]}
	aria-current={isActive ? 'page' : undefined}
	{...props}
>
	<span class="label" set:html={label} />
	<span class="reserve" aria-hidden="true" data-pagefind-ignore set:html={label} />
</a>
<style>
	a {
		display: inline-grid;
		justify-items: center;
		text-decoration: none;
	}
	a > span {
		grid-area: 1 / 1;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
	.reserve {
		font-weight: bolder;
		visibility: hidden;
	}
</style>
