---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';
import SeriesBadge from '../components/SeriesBadge.astro';
import SeriesPager from '../components/SeriesPager.astro';
import { tagUrl, type SeriesNav } from '../lib/posts';

// The post's own frontmatter, plus its place in a series when it has one.
// Standalone posts pass no `nav` and render exactly as they did before.
type Props = CollectionEntry<'blog'>['data'] & { nav?: SeriesNav; ogImage?: string };

const { title, description, pubDate, updatedDate, heroImage, tags, draft, nav, ogImage } =
	Astro.props;

// The browser tab, the bookmark and the shared link all show this rather than
// the <h1>, so a part of a series names its series and its position. No total:
// the outline is one click away on the series page, and a count in every tab
// title ages badly — it changes for every article whenever a part is added.
const pageTitle = nav ? `${nav.series.title} — part ${nav.part}: ${title}` : title;
---

<BaseLayout title={pageTitle} description={description} image={heroImage} ogImage={ogImage}>
	<article>
		{
			heroImage && (
				<div class="hero-image">
					<Image width={1020} height={510} src={heroImage} alt="" />
				</div>
			)
		}
		<div class="title">
			{nav && <SeriesBadge nav={nav} />}
			{
				draft && (
					<p class="draft-notice">
						Draft — this is unfinished and is not published on the live site.
					</p>
				)
			}
			<h1>{title}</h1>
			<p class="date">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span class="last-updated-on">
							(last updated on <FormattedDate date={updatedDate} />)
						</span>
					)
				}
			</p>
			{
				tags && tags.length > 0 && (
					<p class="tags">
						Tagged:{' '}
						{tags.map((tag, index) => (
							<>
								{index > 0 && ', '}
								<a href={tagUrl(tag)}>{tag}</a>
							</>
						))}
					</p>
				)
			}
		</div>
		<hr />
		<div class="prose">
			<slot />
		</div>
		{nav && <SeriesPager nav={nav} />}
	</article>
	<Giscus />
</BaseLayout>

<style>
	.hero-image img {
		display: block;
		margin: 0 auto 1.5em auto;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
	.title h1 {
		margin: 0 0 0.25em 0;
	}
	.date {
		margin: 0 0 1em 0;
		color: rgb(var(--gray));
	}
	.last-updated-on {
		font-style: italic;
	}
	.tags {
		margin: 0 0 1em 0;
		font-size: 0.9em;
		color: rgb(var(--gray));
	}
	.draft-notice {
		margin: 0 0 1em 0;
		padding: 0.5em 0.75em;
		border-left: 4px solid var(--accent);
		background: rgba(var(--gray-light), 50%);
		font-weight: 700;
	}
</style>
