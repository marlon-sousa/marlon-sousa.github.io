---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';
import SeriesBadge from '../components/SeriesBadge.astro';
import SeriesPager from '../components/SeriesPager.astro';
import { tagUrl, type SeriesNav } from '../lib/posts';
import { getLocale, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

// The post's own frontmatter, plus its place in a series when it has one.
// Standalone posts pass no `nav` and render exactly as they did before.
type Props = CollectionEntry<'blog'>['data'] & {
	nav?: SeriesNav;
	ogImage?: string;
	/** Locale → path for the languages this article has been written in. */
	translations?: Partial<Record<Locale, string>>;
};

const { title, description, pubDate, updatedDate, heroImage, tags, draft, nav, ogImage, translations } =
	Astro.props;

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

// The browser tab, the bookmark and the shared link all show this rather than
// the <h1>, so a part of a series names its series and its position. No total:
// the outline is one click away on the series page, and a count in every tab
// title ages badly — it changes for every article whenever a part is added.
const pageTitle = nav
	? t('post.pageTitle', { series: nav.series.title, part: nav.part, title })
	: title;
---

<BaseLayout
	title={pageTitle}
	description={description}
	image={heroImage}
	ogImage={ogImage}
	translations={translations}
>
	<article>
		{
			heroImage && (
				<div class="hero-image">
					<Image width={1020} height={510} src={heroImage} alt="" />
				</div>
			)
		}
		<div class="title">
			{nav && <SeriesBadge nav={nav} />}
			{draft && <p class="draft-notice">{t('post.draftNotice')}</p>}
			<h1>{title}</h1>
			<p class="date">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span class="last-updated-on">
							{/* Split around the date so it stays a <time> element rather
							    than a string baked into a sentence. */}
							{t('post.lastUpdated', { date: '{date}' }).split('{date}')[0]}
							<FormattedDate date={updatedDate} />
							{t('post.lastUpdated', { date: '{date}' }).split('{date}')[1]}
						</span>
					)
				}
			</p>
			{
				tags && tags.length > 0 && (
					<p class="tags">
						{t('post.tagged')}{' '}
						{tags.map((tag, index) => (
							<>
								{index > 0 && ', '}
								<a href={tagUrl(tag, locale)}>{tag}</a>
							</>
						))}
					</p>
				)
			}
		</div>
		<hr />
		<div class="prose">
			<slot />
		</div>
		{nav && <SeriesPager nav={nav} />}
	</article>
	<Giscus />
</BaseLayout>

<style>
	.hero-image img {
		display: block;
		margin: 0 auto 1.5em auto;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
	.title h1 {
		margin: 0 0 0.25em 0;
	}
	.date {
		margin: 0 0 1em 0;
		color: rgb(var(--gray));
	}
	.last-updated-on {
		font-style: italic;
	}
	.tags {
		margin: 0 0 1em 0;
		font-size: 0.9em;
		color: rgb(var(--gray));
	}
	.draft-notice {
		margin: 0 0 1em 0;
		padding: 0.5em 0.75em;
		border-left: 4px solid var(--accent);
		background: rgba(var(--gray-light), 50%);
		font-weight: 700;
	}
</style>

<script>
	// Wires up the copy buttons that plugins/rehype-code-language.mjs renders.
	//
	// They ship hidden and are revealed here, so a reader without JavaScript is
	// never offered a control that cannot work — an inert button in the tab order
	// is a promise the page would not keep.
	//
	// The outcome is written into a `role="status"` region rather than only into
	// the button's own label, because a screen reader is not told that a button
	// quietly renamed itself after being pressed.
	const figures = document.querySelectorAll('.code-figure');

	for (const figure of figures) {
		const button = figure.querySelector<HTMLButtonElement>('[data-code-copy]');
		const status = figure.querySelector<HTMLElement>('[data-copy-status]');
		const code = figure.querySelector('pre');
		if (!button || !code || !navigator.clipboard) continue;

		button.hidden = false;
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(code.textContent ?? '');
				button.textContent = 'Copied';
				if (status) status.textContent = 'Copied to the clipboard';
			} catch {
				button.textContent = 'Press Ctrl+C';
				if (status) status.textContent = 'Could not copy. Select the code and copy it yourself.';
			}
			window.setTimeout(() => {
				button.textContent = 'Copy';
				if (status) status.textContent = '';
			}, 4000);
		});
	}
</script>
