---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { alternatesFor, getLocale, localeMeta, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/ui';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	/** Generated social card path, when the page has one of its own. */
	ogImage?: string;
	/** Width of the content column. Articles read better narrow; listings need room. */
	width?: 'prose' | 'wide';
	/**
	 * Whether site search should index this page.
	 *
	 * Listing pages repeat the title and description of everything they link to,
	 * so indexing them means one search hit answered twice: once by the article
	 * and once by the index that mentions it. Set false on any page that only
	 * points at content held elsewhere.
	 */
	searchable?: boolean;
	/**
	 * Where this page can be read in each language, as locale → path. Only an
	 * article needs to pass one; see the same prop on BaseHead.
	 */
	translations?: Partial<Record<Locale, string>>;
}

const {
	title,
	description,
	image,
	ogImage,
	width = 'prose',
	searchable = true,
	translations,
} = Astro.props;

// Read from the URL rather than taken as a prop: the locale is already written
// down in the address of the page being rendered, and a prop could disagree
// with it.
const locale = getLocale(Astro.url);
const t = useTranslations(locale);

// Every page that is a straight translation of one route has mechanical
// alternates. Articles override.
const pageTranslations = translations ?? alternatesFor(Astro.url.pathname);
---

<!doctype html>
<html lang={localeMeta[locale].tag}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			ogImage={ogImage}
			translations={pageTranslations}
		/>
	</head>
	<!-- The ignore attribute belongs on body, not main: anywhere narrower and
	     Pagefind still lists the page, matching only its header and footer. -->
	<body data-pagefind-ignore={searchable ? undefined : 'all'}>
		<a class="skip-link" href="#main-content">{t('nav.skip')}</a>
		<Header translations={pageTranslations} />
		<main id="main-content" class:list={[width]}>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	main.wide {
		width: 960px;
	}
</style>
